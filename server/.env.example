# --- Story text generation (LLM) ---
# Optional. Without any of these set, the server generates Armenian stories
# from local templates (no network calls, fully offline demo mode) — but
# templates only cover the predefined lesson list; a parent's custom
# free-text lesson ALWAYS requires one of these to be configured.
# Preference order: GEMINI_API_KEY > ANTHROPIC_API_KEY/LLM_API_KEY > templates.
# GEMINI_API_KEY is the same key already used for narration below — one key
# covers both story text and voice.
ANTHROPIC_API_KEY=
LLM_API_KEY=
# Optional. Defaults shown.
GEMINI_STORY_MODEL=gemini-2.5-flash

# --- Video generation (Veo 3 on Vertex AI) ---
# Optional. Without VEO_API_KEY + VEO_PROJECT_ID both set, scenes render as an
# animated illustration instead of a generated video (MockVideoProvider).
# This targets Vertex AI (aiplatform.googleapis.com), not the Gemini
# Developer API — a Vertex AI key looks like "AQ...." rather than "AIzaSy...".
VEO_API_KEY=
# Required if VEO_API_KEY is set. Your GCP project id or number (the numeric
# project number works fine, e.g. as seen in Vertex AI Studio's API keys page).
VEO_PROJECT_ID=
# Optional. Defaults to us-central1.
VEO_LOCATION=us-central1
# Optional. Defaults to veo-3.1-generate-001.
VEO_MODEL=veo-3.1-generate-001

# --- Moral-choice future previews (Nano Banana 2 on Vertex AI) ---
# Generates two wordless images that preview the immediate consequence of the
# two moral choices. A Vertex Express Mode key works by itself; a standard
# Vertex key also needs its project ID. If these explicit values are omitted,
# the server reuses the Veo credentials above automatically.
VERTEX_API_KEY=
# Optional for Vertex Express Mode keys; required for standard Vertex keys.
VERTEX_PROJECT_ID=
# Nano Banana image models are available on the global endpoint by default.
VERTEX_LOCATION=global
# Optional. Nano Banana 2's current model id:
CHOICE_IMAGE_MODEL=gemini-3.1-flash-image

# --- Armenian narration ---
# Providers are tried in this order, automatically falling through to the next
# whenever one fails or its quota is exhausted (see
# narrationGenerator/providers/fallbackNarrationProvider.ts):
#   1. Vertex AI  — uses VEO_API_KEY + VEO_PROJECT_ID above (no extra config)
#   2. Gemini Developer API — uses GEMINI_API_KEY
#   3. OpenAI     — uses OPENAI_API_KEY
# With none set, scenes play without narration audio — the child still sees
# Armenian captions and can use the in-app "read aloud" button (Web Speech API).

# Option A (preferred): Gemini TTS hosted on Vertex AI. Requires NO extra
# variables — it reuses VEO_API_KEY/VEO_PROJECT_ID/VEO_LOCATION from the video
# section above. Confirmed to draw on a SEPARATE, much healthier quota pool
# than the Developer API below, and to be more reliable in practice.

# Option B: the same TTS models via the Gemini Developer API. Accepts a plain
# API key from Google AI Studio (https://aistudio.google.com/apikey) — the
# SAME GEMINI_API_KEY used for story text generation above. Caps at ~100
# requests/day per project even when billed (confirmed via testing); one story
# needs ~7, so roughly 14 stories/day before it falls through.
GEMINI_API_KEY=
# Optional. Defaults shown. Used by BOTH the Vertex and Developer API paths.
GEMINI_TTS_MODEL=gemini-2.5-flash-preview-tts
GEMINI_TTS_VOICE=Kore

# Option C (last resort before silence): OpenAI TTS. Different vendor, so it's
# unaffected by any Google-side quota. Simple Bearer-token auth, no service
# account needed. Confirmed working with Armenian text, ~$0.01-0.02/story on
# tts-1. Voices are English-optimized, so Armenian pronunciation is measurably
# less accurate than Gemini's — kept last for that reason.
OPENAI_API_KEY=
# Optional. Defaults shown. tts-1-hd is higher quality, double the cost.
OPENAI_TTS_MODEL=tts-1
OPENAI_TTS_VOICE=alloy

# Option D (only used if none of the above is set, heaviest setup): Google
# Cloud Text-to-Speech. Cloud TTS does NOT accept a simple API key (confirmed
# with both a Vertex and an AI Studio key: it returns 401 CREDENTIALS_MISSING
# and demands OAuth2/service account auth) — so this points at a service account
# JSON key file instead. Create one in a GCP project: IAM & Admin -> Service
# Accounts -> create -> grant "Cloud Text-to-Speech User" -> Keys -> Add key
# -> JSON, then save the downloaded file as server/service-account.json
# (gitignored) and point this at it. Armenian (hy-AM) is a preview-status
# language on Google's side there.
GOOGLE_APPLICATION_CREDENTIALS=./service-account.json

# Optional. Defaults to 4000.
PORT=4000
