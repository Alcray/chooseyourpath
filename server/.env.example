# --- Story text generation (LLM) ---
# Optional. Without any of these set, the server generates Armenian stories
# from local templates (no network calls, fully offline demo mode) — but
# templates only cover the predefined lesson list; a parent's custom
# free-text lesson ALWAYS requires one of these to be configured.
# Preference order: GEMINI_API_KEY > ANTHROPIC_API_KEY/LLM_API_KEY > templates.
# GEMINI_API_KEY is the same key already used for narration below — one key
# covers both story text and voice.
ANTHROPIC_API_KEY=
LLM_API_KEY=
# Optional. Defaults shown.
GEMINI_STORY_MODEL=gemini-2.5-flash

# --- Video generation (Veo 3 on Vertex AI) ---
# Optional. Without VEO_API_KEY + VEO_PROJECT_ID both set, scenes render as an
# animated illustration instead of a generated video (MockVideoProvider).
# This targets Vertex AI (aiplatform.googleapis.com), not the Gemini
# Developer API — a Vertex AI key looks like "AQ...." rather than "AIzaSy...".
VEO_API_KEY=
# Required if VEO_API_KEY is set. Your GCP project id or number (the numeric
# project number works fine, e.g. as seen in Vertex AI Studio's API keys page).
VEO_PROJECT_ID=
# Optional. Defaults to us-central1.
VEO_LOCATION=us-central1
# Optional. Defaults to veo-3.1-generate-001.
VEO_MODEL=veo-3.1-generate-001

# --- Moral-choice future previews (Nano Banana 2 on Vertex AI) ---
# Generates two wordless images that preview the immediate consequence of the
# two moral choices. If these explicit values are omitted, the server reuses
# VEO_API_KEY and VEO_PROJECT_ID above automatically.
VERTEX_API_KEY=
VERTEX_PROJECT_ID=
# Nano Banana image models are available on the global endpoint by default.
VERTEX_LOCATION=global
# Optional. Nano Banana 2's current model id:
CHOICE_IMAGE_MODEL=gemini-3.1-flash-image

# --- Armenian narration ---
# If both GEMINI_API_KEY and OPENAI_API_KEY are set, Gemini is tried first
# (cheaper, better Armenian pronunciation) and OpenAI is used automatically
# as a fallback whenever Gemini fails or its daily quota is exhausted — see
# narrationGenerator/providers/fallbackNarrationProvider.ts. With neither set,
# scenes play without narration audio — the child still sees Armenian
# captions and can use the in-app "read aloud" button (browser Web Speech API).

# Option A (preferred, lightweight): Gemini's native TTS. Accepts a plain API
# key from Google AI Studio (https://aistudio.google.com/apikey). This is the
# SAME GEMINI_API_KEY used for story text generation above — set it once,
# used for both. Confirmed working with Armenian text. CAPS AT ~100
# REQUESTS/DAY even when billed (confirmed via testing) — a single story
# needs ~7, so this is roughly 14 stories/day before it needs the fallback.
GEMINI_API_KEY=
# Optional. Defaults shown.
GEMINI_TTS_MODEL=gemini-2.5-flash-preview-tts
GEMINI_TTS_VOICE=Kore

# Option B (fallback, or primary if Gemini isn't set): OpenAI TTS. Simple
# Bearer-token auth, no service account needed. Confirmed working with
# Armenian text, ~$0.01-0.02/story on tts-1. Voices are English-optimized,
# so Armenian pronunciation is measurably less accurate than Gemini's — kept
# as the fallback for that reason, not the default.
OPENAI_API_KEY=
# Optional. Defaults shown. tts-1-hd is higher quality, double the cost.
OPENAI_TTS_MODEL=tts-1
OPENAI_TTS_VOICE=alloy

# Option C (only used if neither above is set, heaviest setup): Google Cloud
# Text-to-Speech. Cloud TTS does NOT accept a simple API key (confirmed: it
# demands OAuth2/service account auth) — so this points at a service account
# JSON key file instead. Create one in a GCP project: IAM & Admin -> Service
# Accounts -> create -> grant "Cloud Text-to-Speech User" -> Keys -> Add key
# -> JSON, then save the downloaded file as server/service-account.json
# (gitignored) and point this at it. Armenian (hy-AM) is a preview-status
# language on Google's side there.
GOOGLE_APPLICATION_CREDENTIALS=./service-account.json

# Optional. Defaults to 4000.
PORT=4000
